build BCLoad/CMakeFiles/BCPass-20.dir/BCLoader.cpp.o: CXX_COMPILER__BCPass-20_unscanned_Release /home/luke/Code/betaflight/tools/Enzyme/enzyme/BCLoad/BCLoader.cpp || cmake_object_order_depends_target_BCPass-20
  CONFIG = Release
  DEFINES = -DENZYME_VERSION_MAJOR=0 -DENZYME_VERSION_MINOR=0 -DENZYME_VERSION_PATCH=79
  DEP_FILE = BCLoad/CMakeFiles/BCPass-20.dir/BCLoader.cpp.o.d
  FLAGS = -Wall -fno-rtti  -Werror=implicit-fallthrough -Werror=unused-variable -Werror=dangling-else -Werror=unused-but-set-variable -Werror=return-type -Werror=nonnull -Werror=unused-result -Werror=reorder -Werror=switch -O2 -std=gnu++17 -fPIC   -D_GNU_SOURCE -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
  INCLUDES = -I/usr/lib/llvm/20/include -I/home/luke/Code/betaflight/tools/enzyme_build/include -I/home/luke/Code/betaflight/tools/enzyme_build/BCLoad/gsl
  OBJECT_DIR = BCLoad/CMakeFiles/BCPass-20.dir
