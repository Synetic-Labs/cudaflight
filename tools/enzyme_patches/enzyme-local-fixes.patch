diff --git a/enzyme/Enzyme/AdjointGenerator.h b/enzyme/Enzyme/AdjointGenerator.h
index 5dbeb27..d294616 100644
--- a/enzyme/Enzyme/AdjointGenerator.h
+++ b/enzyme/Enzyme/AdjointGenerator.h
@@ -5957,9 +5957,30 @@ public:
         for (size_t i = 0; i < argsInverted.size(); i++) {
           if (subdata->constant_args[i] == argsInverted[i])
             continue;
-          assert(subdata->constant_args[i] == DIFFE_TYPE::DUP_ARG);
-          assert(argsInverted[i] == DIFFE_TYPE::DUP_NONEED);
-          argsInverted[i] = DIFFE_TYPE::DUP_ARG;
+          auto aug = subdata->constant_args[i];
+          auto rev = argsInverted[i];
+          auto isDup = [](DIFFE_TYPE t) {
+            return t == DIFFE_TYPE::DUP_ARG || t == DIFFE_TYPE::DUP_NONEED;
+          };
+          // The reverse must match the augmented primal that was actually
+          // built (its tape layout / shadow-argument signature is fixed).
+          // DUP_ARG and DUP_NONEED share the same signature ("same as DUP_ARG
+          // otherwise"), so any dup/dup mismatch is reconcilable by adopting
+          // the augmented's choice. Activity analysis can legitimately differ
+          // between the augmented and gradient sweeps of a caller (e.g. when a
+          // value's activity is threaded through globals), so this is not an
+          // error.
+          if (isDup(aug) && isDup(rev)) {
+            argsInverted[i] = aug;
+            continue;
+          }
+          llvm::errs() << "Enzyme: reconciling arg #" << i << " of call to "
+                       << called->getName() << " in "
+                       << gutils->oldFunc->getName()
+                       << ": augmented=" << to_string(aug)
+                       << " gradient=" << to_string(rev)
+                       << " -> adopting augmented\n";
+          argsInverted[i] = aug;
         }
       }
 
